    def Scope "FilmLooks"
    {
        def Material "Track"
        {
            token outputs:surface
            token outputs:surface.connect = </World/FilmLooks/Track/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                custom color3f inputs:diffuseColor = (0.014000000432133675, 0.01899999938905239, 0.027000000700354576)
                custom float inputs:roughness = 0.3100000023841858
                custom float inputs:metallic = 0.11999999731779099
                custom color3f inputs:emissiveColor = (0.0, 0.0, 0.0)
                custom token outputs:surface = ""
            }
        }
        def Material "Ground"
        {
            token outputs:surface
            token outputs:surface.connect = </World/FilmLooks/Ground/Shader.outputs:surface>
            def Shader "Shader"
            {
