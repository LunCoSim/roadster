#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "World" (
    prepend references = @roadster_roof_check.usda@</World>
)
{
    over "Roadster"
    {
        double3 xformOp:translate = (0.0, 3.0, 0.0)
    }
    over "DriverSetup"
    {
        uniform asset info:sourceAsset = @twin://tesla-roadster-runner/scenarios/tests/roof_overload.rhai@
    }
}
