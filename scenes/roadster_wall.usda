    def Xform "Roadster" (
        prepend references = @../vehicles/roadster.usda@</Roadster>
        variants = { string "trim" = "Rocket" }
    )
    {
        double3 xformOp:translate = (0.0, 30.0, 0.46)
        double3 xformOp:rotateXYZ = (90.0, 0.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        float inputs:fan_initial_fraction = 1.0
        over "Wheel_FL"
        {
            double3 xformOp:translate = (-0.86, 31.375, 0.24999999999999994)
            custom double3 xformOp:rotateXYZ = (90.0, 0.0, 0.0)
            uniform token[] xformOpOrder = ["!resetXformStack!", "xformOp:translate", "xformOp:rotateXYZ"]
        }
        over "Suspension_FL"
        {
            custom double3 xformOp:translate = (-0.86, 31.375, 0.24999999999999994)
            custom double3 xformOp:rotateXYZ = (90.0, 0.0, 0.0)
            uniform token[] xformOpOrder = ["!resetXformStack!", "xformOp:translate", "xformOp:rotateXYZ"]
        }
        over "SteeringKnuckle_FL"
        {
            custom double3 xformOp:translate = (-0.86, 31.375, 0.24999999999999994)
            custom double3 xformOp:rotateXYZ = (90.0, 0.0, 0.0)
            uniform token[] xformOpOrder = ["!resetXformStack!", "xformOp:translate", "xformOp:rotateXYZ"]
        }
        over "Wheel_FR"
        {
