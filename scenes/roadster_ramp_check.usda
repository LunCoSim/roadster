#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "World" (
    kind = "assembly"
)
{
    def PhysicsScene "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        vector3f physics:gravityDirection = (0.0, -1.0, 0.0)
        float physics:gravityMagnitude = 9.806650161743164
        custom bool physxScene:enableCCD = true
    }
    def DistantLight "Sun" (
        prepend references = @lunco://lighting/sun.usda@</Sun>
    )
    {
        float inputs:intensity = 128000.0
        color3f inputs:color = (1.0, 0.949999988079071, 0.8700000047683716)
        double3 xformOp:rotateXYZ = (-50.0, -35.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
    def DomeLight "Fill"
    {
        float inputs:intensity = 700.0
        color3f inputs:color = (0.550000011920929, 0.6800000071525574, 0.8500000238418579)
    }
    def Xform "EarthSky" (
        prepend apiSchemas = ["LunCoProceduralSkyAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/EarthSky/Look>
        def Material "Look"
        {
            token outputs:surface
            token outputs:surface.connect = </World/EarthSky/Look/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                asset info:wgsl:sourceAsset = @../shaders/earth_sky.wgsl@
                float inputs:brightness = 1.0
                token outputs:surface
            }
        }
    }
