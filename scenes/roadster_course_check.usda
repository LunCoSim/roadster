    def Xform "Roadster" (
        prepend references = @../vehicles/roadster.usda@</Roadster>
        variants = { string "trim" = "Rocket" }
    )
    {
        double3 xformOp:translate = (0.0, 0.66, 200.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:course_enabled = 1.0
        float inputs:course_phase = 0.0
        float inputs:course_blocks_passed = 0.0
        float inputs:course_position_y = 0.6600000262260437
        float outputs:course_stage = 0.0
        float outputs:course_blocks = 0.0
        float outputs:course_time_s = 0.0
        float outputs:course_air_rotation_degrees = 0.0
        float outputs:target_distance_m = 0.0
        float outputs:launch_gate = 0.0
        float outputs:refill_zone = 0.0
        float outputs:refill_ready = 0.0
        float outputs:jump_clearance = 0.0
        float outputs:climb_gate = 0.0
        float outputs:landing_gate = 0.0
        over "DriverCamera"
        {
            float exposure:iso = 400.0
            float exposure:time = 0.01666666753590107
            float exposure:fStop = 2.799999952316284
        }
        over "Wheel_FL"
        {
            double3 xformOp:translate = (-0.86, 0.45000000000000007, 198.625)
            custom double3 xformOp:rotateXYZ = (0.0, 0.0, 0.0)
            uniform token[] xformOpOrder = ["!resetXformStack!", "xformOp:translate", "xformOp:rotateXYZ"]
        }
        over "Suspension_FL"
