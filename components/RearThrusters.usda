#usda 1.0
(
    defaultPrim = "RearThrusters"
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "RearThrusters" (kind = "component") {
def Cylinder "Nozzle0" {
    uniform token axis = "Z"
    double radius = 0.072
    double height = 0.14
    double3 xformOp:translate = (-0.55,-0.02,2.3)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    color3f[] primvars:displayColor = [(0.012,0.016,0.020)]
    bool physics:collisionEnabled = false
}
def Cylinder "Nozzle1" {
    uniform token axis = "Z"
    double radius = 0.072
    double height = 0.14
    double3 xformOp:translate = (-0.2,-0.02,2.3)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    color3f[] primvars:displayColor = [(0.012,0.016,0.020)]
    bool physics:collisionEnabled = false
}
def Cylinder "Nozzle2" {
    uniform token axis = "Z"
    double radius = 0.072
    double height = 0.14
    double3 xformOp:translate = (0.2,-0.02,2.3)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    color3f[] primvars:displayColor = [(0.012,0.016,0.020)]
    bool physics:collisionEnabled = false
}
def Cylinder "Nozzle3" {
    uniform token axis = "Z"
    double radius = 0.072
    double height = 0.14
    double3 xformOp:translate = (0.55,-0.02,2.3)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    color3f[] primvars:displayColor = [(0.012,0.016,0.020)]
    bool physics:collisionEnabled = false
}
def Scope "Looks" {
def Material "Rear" {
    token outputs:surface.connect = </RearThrusters/Looks/Rear/Surface.outputs:surface>
    def Shader "Surface" {
        uniform token info:implementationSource = "sourceAsset"
        asset info:wgsl:sourceAsset = @../shaders/air_jet.wgsl@
        float inputs:force = 0
        float inputs:direction = -1
        float inputs:reference_force = 30000
        float inputs:radius_start = 0.04
        float inputs:radius_expanded = 0.06
        float inputs:expansion_length = 0.3
        float inputs:mixing_length = 1.5
        float inputs:radius_end = 0.16
        float inputs:exit_velocity = 600
        token outputs:surface
    }
}
}
