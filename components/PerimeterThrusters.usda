def Scope "Looks" {
def Material "Lift" {
    token outputs:surface.connect = </PerimeterThrusters/Looks/Lift/Surface.outputs:surface>
    def Shader "Surface" {
        uniform token info:implementationSource = "sourceAsset"
        asset info:wgsl:sourceAsset = @../shaders/air_jet.wgsl@
        float inputs:force = 0
        float inputs:direction = 1
        float inputs:reference_force = 30000
        token outputs:surface
    }
}
def Material "Left" {
    token outputs:surface.connect = </PerimeterThrusters/Looks/Left/Surface.outputs:surface>
    def Shader "Surface" {
        uniform token info:implementationSource = "sourceAsset"
        asset info:wgsl:sourceAsset = @../shaders/air_jet.wgsl@
        float inputs:force = 0
        float inputs:direction = 1
        float inputs:reference_force = 5000
        token outputs:surface
    }
}
def Material "Right" {
    token outputs:surface.connect = </PerimeterThrusters/Looks/Right/Surface.outputs:surface>
    def Shader "Surface" {
        uniform token info:implementationSource = "sourceAsset"
        asset info:wgsl:sourceAsset = @../shaders/air_jet.wgsl@
        float inputs:force = 0
        float inputs:direction = -1
        float inputs:reference_force = 5000
        token outputs:surface
    }
}
}
