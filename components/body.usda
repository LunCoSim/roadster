                float inputs:metallic = 0.2800000011920929
                float inputs:roughness = 0.3799999952316284
                color3f inputs:emissiveColor = (0.0, 0.0, 0.0)
                token outputs:surface
            }
        }
        def Material "Lamp"
        {
            token outputs:surface
            token outputs:surface.connect = </Body/Looks/Lamp/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8500000238418579, 0.8999999761581421, 1.0)
                float inputs:metallic = 0.10000000149011612
                float inputs:roughness = 0.18000000715255737
