#usda 1.0
(
    defaultPrim = "Body"
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "Body" (kind = "component")
{
def Scope "Looks" {
def Material "White"
{
    token outputs:surface.connect = </Body/Looks/White/Shader.outputs:surface>
    def Shader "Shader"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor = (0.83, 0.86, 0.88)
        float inputs:metallic = 0.35
        float inputs:roughness = 0.24
        color3f inputs:emissiveColor = (0, 0, 0)
        token outputs:surface
    }
}
def Material "Glass"
{
    token outputs:surface.connect = </Body/Looks/Glass/Shader.outputs:surface>
    def Shader "Shader"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor = (0.28, 0.17, 0.055)
        float inputs:metallic = 0.72
        float inputs:roughness = 0.15
        color3f inputs:emissiveColor = (0, 0, 0)
        token outputs:surface
    }
}
def Material "Carbon"
{
    token outputs:surface.connect = </Body/Looks/Carbon/Shader.outputs:surface>
    def Shader "Shader"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor = (0.022, 0.028, 0.035)
        float inputs:metallic = 0.28
        float inputs:roughness = 0.38
        color3f inputs:emissiveColor = (0, 0, 0)
        token outputs:surface
    }
}
def Material "Lamp"
{
    token outputs:surface.connect = </Body/Looks/Lamp/Shader.outputs:surface>
    def Shader "Shader"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor = (0.85, 0.9, 1)
        float inputs:metallic = 0.1
        float inputs:roughness = 0.18
        color3f inputs:emissiveColor = (2, 2.2, 2.5)
        token outputs:surface
    }
}
def Material "RearLamp"
{
    token outputs:surface.connect = </Body/Looks/RearLamp/Shader.outputs:surface>
    def Shader "Shader"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor = (0.45, 0.005, 0.008)
        float inputs:metallic = 0.1
        float inputs:roughness = 0.2
        color3f inputs:emissiveColor = (1.8, 0.008, 0.015)
        token outputs:surface
    }
}
def Material "FanRotor" {
        token outputs:surface.connect = </Body/Looks/FanRotor/Surface.outputs:surface>
        def Shader "Surface" {
            uniform token info:implementationSource = "sourceAsset"
            asset info:wgsl:sourceAsset = @../shaders/suction_fan.wgsl@
            float inputs:angle = 0
            float inputs:rpm = 0
            token outputs:surface
        }
    }
}
