            }
        }
        def Material "RearLamp"
        {
            token outputs:surface
            token outputs:surface.connect = </Body/Looks/RearLamp/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.44999998807907104, 0.004999999888241291, 0.00800000037997961)
                float inputs:metallic = 0.10000000149011612
                float inputs:roughness = 0.20000000298023224
                color3f inputs:emissiveColor = (1.7999999523162842, 0.00800000037997961, 0.014999999664723873)
                token outputs:surface
            }
        }
        def Material "FanRotor"
        {
            token outputs:surface
            token outputs:surface.connect = </Body/Looks/FanRotor/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:implementationSource = "sourceAsset"
                asset info:wgsl:sourceAsset = @../shaders/suction_fan.wgsl@
                float inputs:angle = 0.0
                float inputs:rpm = 0.0
                token outputs:surface
            }
        }
        def Material "SideGlass"
        {
            token outputs:surface
            token outputs:surface.connect = </Body/Looks/SideGlass/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                custom color3f inputs:diffuseColor = (0.04500000178813934, 0.054999999701976776, 0.06400000303983688)
                custom float inputs:metallic = 0.3799999952316284
                custom float inputs:roughness = 0.18000000715255737
                custom token outputs:surface = ""
            }
        }
    }
