#usda 1.0
(
    defaultPrim = "Body"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "Body" (
    kind = "component"
)
{
    custom string study:visualReference = "\"MotorTrend reveal photo gallery; references/body-style.md. Original study mesh, not Tesla CAD.\""
