#usda 1.0
(
    defaultPrim = "FanAdhesion"
    upAxis = "Y"
    metersPerUnit = 1.0
    documentation = "Internal geometry adapter for FanAdhesion.mo. Four native clearance queries; no visible sensors or force/pose controller. The physical vehicle consumes only the resulting wrench and electrical load."
)

def Xform "FanAdhesion"
{
    def Xform "Probe0" (
        prepend references = @SurfaceProbe.usda@</SurfaceProbe>
    )
    {
        custom double3 xformOp:translate = (-0.6, -0.3, -1.1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "Probe1" (
        prepend references = @SurfaceProbe.usda@</SurfaceProbe>
    )
    {
        custom double3 xformOp:translate = (-0.6, -0.3, 1.1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "Probe2" (
        prepend references = @SurfaceProbe.usda@</SurfaceProbe>
    )
    {
        custom double3 xformOp:translate = (0.6, -0.3, -1.1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "Probe3" (
        prepend references = @SurfaceProbe.usda@</SurfaceProbe>
    )
    {
        custom double3 xformOp:translate = (0.6, -0.3, 1.1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
