    custom double outputs:tank_temperature_c = 0.0
    custom double outputs:tank_wall_temperature_c = 0.0
    custom double outputs:thermal_guard_temperature_c = 0.0
    variantSet "trim" = {
        "Performance" {
            float inputs:boost_available = 0.0
            float inputs:lift_available = 0.0
            custom float inputs:rear_tank_volume = 0.20000000298023224
            custom float inputs:cabin_tank_volume = 0.4000000059604645
        }
        "Thrust" {
            float inputs:boost_available = 1.0
            custom float inputs:cabin_tank_volume = 0.0
            custom float inputs:rear_tank_volume = 0.20000000298023224
            def Xform "RearThrusters" (
                prepend references = @../components/RearThrusters.usda@</RearThrusters>
            )
            {
                over "Jet0"
                {
                    float inputs:force
                    float inputs:force.connect = </Roadster.outputs:jet_rear_each_n>
                    float inputs:radius_start
                    float inputs:radius_start.connect = </Roadster.outputs:plume_rear_radius_start>
                    float inputs:radius_expanded
                    float inputs:radius_expanded.connect = </Roadster.outputs:plume_rear_radius_expanded>
                    float inputs:expansion_length
