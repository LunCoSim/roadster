#usda 1.0
(
    defaultPrim = "Roadster"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "Roadster" (
    kind = "assembly"
    documentation = "October 2026 Roadster study. Geometry and performance parameters are assumptions, not Tesla CAD or calibration."
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI", "PhysxVehicleContextAPI", "LunCoCatalogAPI", "LunCoProgramAPI", "LunCoUiSchemaAPI"]
