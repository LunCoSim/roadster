    float outputs:fan_vacuum_kpa
    float outputs:fan_power_kw
    float outputs:flight_control_weight
    float outputs:pitch_rate_deg_s
    float outputs:roll_rate_deg_s
    float outputs:yaw_rate_deg_s
    float outputs:air_fill_percent
    float outputs:refill_allowed
    float outputs:refill_active
    float outputs:refill_complete
    float outputs:refill_finished
    float outputs:refill_flow_kg_s
    float outputs:service_power_w
    float outputs:service_power_mw
    float outputs:service_air_used_kg
    float outputs:service_energy_j
    float outputs:plume_rear_radius_start
    float outputs:plume_rear_radius_expanded
    float outputs:plume_rear_expansion_length
    float outputs:plume_rear_mixing_length
    float outputs:plume_rear_radius_end
    float outputs:plume_rear_exit_velocity
    float outputs:plume_side_radius_start
    float outputs:plume_side_radius_expanded
    float outputs:plume_side_expansion_length
    float outputs:plume_side_mixing_length
    float outputs:plume_side_radius_end
    float outputs:plume_side_exit_velocity
    def Cylinder "Wheel_FL" (
        prepend apiSchemas = ["PhysxVehicleWheelAttachmentAPI", "PhysxVehicleWheelAPI"]
        prepend references = [@lunco://components/mobility/wheel.usda@</Wheel>, @lunco://components/mobility/suspensions/standard.usda@</Suspension>]
        prepend variantSets = ["tire"]
        variants = { string tire = "road" }
    ) {
        double3 xformOp:translate = (-0.86,-0.21,-1.375)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        double radius = 0.34
        double height = 0.25
        float physxVehicleWheel:radius = 0.34
        float physxVehicleWheel:width = 0.25
        float physxVehicleWheel:mass = 24
        float physxVehicleWheel:moi = 1.4
        float physxVehicleWheel:dampingRate = 0.08
        float physxVehicleWheel:maxBrakeTorque = 4000
        int physxVehicleWheelAttachment:index = 0
        float lunco:suspension:restLength = 0.43
        float physxVehicleSuspension:springStrength = 300000 (customData = { double max = 1000000 })
        float physxVehicleSuspension:springDamperRate = 14000
        float inputs:drive.connect = </Roadster.outputs:freewheel_torque>
        float inputs:heading.connect = </Roadster.outputs:heading_fl>
        variantSet "tire" = { "road" (prepend references = @../components/road_tire.usda@</RoadTire>) {} }
        over "SuspensionCasing" { token visibility = "invisible" }
        over "SuspensionPiston" { token visibility = "invisible" }
        over "SuspensionSpring" { token visibility = "invisible" }
    }
    def Cylinder "Wheel_FR" (
        prepend apiSchemas = ["PhysxVehicleWheelAttachmentAPI", "PhysxVehicleWheelAPI"]
        prepend references = [@lunco://components/mobility/wheel.usda@</Wheel>, @lunco://components/mobility/suspensions/standard.usda@</Suspension>]
        prepend variantSets = ["tire"]
        variants = { string tire = "road" }
    ) {
        double3 xformOp:translate = (0.86,-0.21,-1.375)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        double radius = 0.34
        double height = 0.25
        float physxVehicleWheel:radius = 0.34
        float physxVehicleWheel:width = 0.25
        float physxVehicleWheel:mass = 24
        float physxVehicleWheel:moi = 1.4
        float physxVehicleWheel:dampingRate = 0.08
        float physxVehicleWheel:maxBrakeTorque = 4000
        int physxVehicleWheelAttachment:index = 1
        float lunco:suspension:restLength = 0.43
        float physxVehicleSuspension:springStrength = 300000 (customData = { double max = 1000000 })
        float physxVehicleSuspension:springDamperRate = 14000
        float inputs:drive.connect = </Roadster.outputs:freewheel_torque>
        float inputs:heading.connect = </Roadster.outputs:heading_fr>
        variantSet "tire" = { "road" (prepend references = @../components/road_tire.usda@</RoadTire>) {} }
        over "SuspensionCasing" { token visibility = "invisible" }
        over "SuspensionPiston" { token visibility = "invisible" }
        over "SuspensionSpring" { token visibility = "invisible" }
    }
    def Cylinder "Wheel_RL" (
        prepend apiSchemas = ["PhysxVehicleWheelAttachmentAPI", "PhysxVehicleWheelAPI"]
        prepend references = [@lunco://components/mobility/wheel.usda@</Wheel>, @lunco://components/mobility/suspensions/standard.usda@</Suspension>]
        prepend variantSets = ["tire"]
        variants = { string tire = "road" }
    ) {
        double3 xformOp:translate = (-0.86,-0.21,1.375)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        double radius = 0.34
        double height = 0.3
        float physxVehicleWheel:radius = 0.34
        float physxVehicleWheel:width = 0.3
        float physxVehicleWheel:mass = 24
        float physxVehicleWheel:moi = 1.4
        float physxVehicleWheel:dampingRate = 0.08
        float physxVehicleWheel:maxBrakeTorque = 4000
        int physxVehicleWheelAttachment:index = 2
        float lunco:suspension:restLength = 0.43
        float physxVehicleSuspension:springStrength = 300000 (customData = { double max = 1000000 })
        float physxVehicleSuspension:springDamperRate = 14000
        float inputs:drive.connect = </Roadster.outputs:torque_left>
        float inputs:heading = 0
        variantSet "tire" = { "road" (prepend references = @../components/road_tire.usda@</RoadTire>) {} }
        over "SuspensionCasing" { token visibility = "invisible" }
        over "SuspensionPiston" { token visibility = "invisible" }
        over "SuspensionSpring" { token visibility = "invisible" }
    }
    def Cylinder "Wheel_RR" (
        prepend apiSchemas = ["PhysxVehicleWheelAttachmentAPI", "PhysxVehicleWheelAPI"]
        prepend references = [@lunco://components/mobility/wheel.usda@</Wheel>, @lunco://components/mobility/suspensions/standard.usda@</Suspension>]
        prepend variantSets = ["tire"]
        variants = { string tire = "road" }
    ) {
        double3 xformOp:translate = (0.86,-0.21,1.375)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        double radius = 0.34
        double height = 0.3
        float physxVehicleWheel:radius = 0.34
        float physxVehicleWheel:width = 0.3
        float physxVehicleWheel:mass = 24
        float physxVehicleWheel:moi = 1.4
        float physxVehicleWheel:dampingRate = 0.08
        float physxVehicleWheel:maxBrakeTorque = 4000
        int physxVehicleWheelAttachment:index = 3
        float lunco:suspension:restLength = 0.43
        float physxVehicleSuspension:springStrength = 300000 (customData = { double max = 1000000 })
        float physxVehicleSuspension:springDamperRate = 14000
        float inputs:drive.connect = </Roadster.outputs:torque_right>
        float inputs:heading = 0
        variantSet "tire" = { "road" (prepend references = @../components/road_tire.usda@</RoadTire>) {} }
        over "SuspensionCasing" { token visibility = "invisible" }
        over "SuspensionPiston" { token visibility = "invisible" }
        over "SuspensionSpring" { token visibility = "invisible" }
    }

    def LunCoEvent "AirRefilled" {
        uniform token lunco:event:name = "roadster_air_refilled"
        uniform bool lunco:event:latched = false
        float inputs:trigger.connect = </Roadster.outputs:refill_finished>
    }
    variantSet "trim" = {
        "Performance" {
            float inputs:boost_available = 0
            float inputs:lift_available = 0
            float inputs:gas_capacity_kg = 250
        }
        "Thrust" {
            float inputs:boost_available = 1
            float inputs:gas_capacity_kg = 250
            def Xform "RearThrusters" (prepend references = @../components/RearThrusters.usda@</RearThrusters>) {
                over "Jet0" { float inputs:force.connect = </Roadster.outputs:jet_rear_each_n>
                    float inputs:radius_start.connect = </Roadster.outputs:plume_rear_radius_start>
                    float inputs:radius_expanded.connect = </Roadster.outputs:plume_rear_radius_expanded>
                    float inputs:expansion_length.connect = </Roadster.outputs:plume_rear_expansion_length>
                    float inputs:mixing_length.connect = </Roadster.outputs:plume_rear_mixing_length>
                    float inputs:radius_end.connect = </Roadster.outputs:plume_rear_radius_end>
                    float inputs:exit_velocity.connect = </Roadster.outputs:plume_rear_exit_velocity>
                }
